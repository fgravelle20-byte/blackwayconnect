# Vite build-time tracking (copy to .env — do not commit real IDs if sensitive)
# See TRACKING.md and ads/GROWTH_META_7DAYS.md

VITE_META_PIXEL_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# Wix Payments checkout URLs — JSON map of plan keys to Wix Payment Link URLs.
# Example: {"grow_hub_growth":"https://www.wix.com/checkout/...","cell_signal":"https://..."}
# Empty = checkout falls back to the contact page (no broken links).
VITE_WIX_CHECKOUT_URLS=

# Server-only Vorixa Base44 CRM (scripts/upsert-g-martel-vorixa.mjs). Never prefix with VITE_.
VORIXA_BASE44_API_KEY=