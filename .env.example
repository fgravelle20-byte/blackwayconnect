# ============================================
# BlackWayConnect Engine v2.0 - Configuration
# ============================================

# Environnement
ENV=production
PORT=3000
DEBUG=false

# Sentry - Monitoring & Performance
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Chatbase
CHATBASE_API_KEY=your-chatbase-api-key
CHATBASE_BOT_ID=your-bot-id

# Gmail SMTP
GMAIL_SERVICE_EMAIL=service@blackwayconnect.com
GMAIL_ACCOUNTING_EMAIL=accounting@blackwayconnect.com
GMAIL_APP_PASSWORD=your-app-password

# SEO APIs
GOOGLE_PLACES_API_KEY=your-google-places-key
PAGESPEED_API_KEY=your-pagespeed-key

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
WIX_WEBHOOK_URL=https://www.blackwayconnect.com/_functions/leadWebhook

# Dashboard
DASHBOARD_SECRET=your-dashboard-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
