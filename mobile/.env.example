# RevenueCat access gate — copy to mobile/.env and fill with your PUBLIC SDK keys.
# Dashboard: https://app.revenuecat.com → Project settings → API keys → "Public app-specific" (SDK) keys.
# These are PUBLIC client keys (safe to ship in the app). Do NOT put the secret API key here.

# iOS public SDK key (starts with "appl_")
VITE_RC_IOS_KEY=

# Android public SDK key (starts with "goog_")
VITE_RC_ANDROID_KEY=

# Entitlement identifier that unlocks the app (RevenueCat → Entitlements). Defaults to "pro".
VITE_RC_ENTITLEMENT=pro
