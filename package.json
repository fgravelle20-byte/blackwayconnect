{
  "name": "noirroutes",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @noirroutes/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:web": "pnpm --filter @noirroutes/web build",
    "lint:web": "pnpm --filter @noirroutes/web lint",
    "typecheck:web": "pnpm --filter @noirroutes/web typecheck",
    "test:e2e": "pnpm --filter @noirroutes/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
