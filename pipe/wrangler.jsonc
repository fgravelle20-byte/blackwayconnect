{
  "name": "blackway-pipe",
  "account_id": "eda7fc96b400297aaa0b185a26ad1846",
  "main": "index.js",
  "compatibility_date": "2025-08-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "api.blackwayconnect.com/*", "zone_name": "blackwayconnect.com" }
  ],
  // PAYMENT-LOCKED — BW_PADDLE_FULFILL_KEY shared with Vorixa blackwayPaddleWebhook.
  // Do not remove or rotate without ops/payment-lock unlock procedure.
  // Shared with Vorixa blackwayPaddleWebhook → POST /portal/provision (CF API token cannot write Worker secrets).
  "vars": {
    "BW_PADDLE_FULFILL_KEY": "eed3b27fa66fd71ca7b807d5e80b522de964ec81c05c7f22"
  },
  "kv_namespaces": [
    { "binding": "BW_SESSIONS", "id": "a3fb004e752a449798390b1df8850e76" },
    { "binding": "BW_WORKSPACES", "id": "4988ffc2782e4a4ea0654a632defa1ea" }
  ],
  // Master King System — customers, payments and leads (source of truth; HubSpot = optional mirror).
  "d1_databases": [
    { "binding": "BW_DB", "database_name": "bw-master", "database_id": "fce2e82f-ad00-4187-a456-b445c4657038", "migrations_dir": "migrations" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
