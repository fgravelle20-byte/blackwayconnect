# ============================================================
# BlackWay Lead Engine — Variables d'environnement
# Copiez ce fichier vers ".env" et remplissez les valeurs réelles.
# NE JAMAIS committer le fichier ".env" (voir .gitignore).
# ============================================================

# --- HubSpot ---------------------------------------------------
# Jeton d'une Private App HubSpot (voir README.md pour les scopes exacts)
HUBSPOT_TOKEN=

# --- Stripe ------------------------------------------------------
# Clé secrète de l'API Stripe (sk_live_... ou sk_test_...)
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Slack (Incoming Webhooks) -----------------------------------
# Webhook du canal #blackway-leads (nouveaux leads)
SLACK_WEBHOOK_LEADS=
# Webhook du canal #blackway-wins (deals gagnés / payés)
SLACK_WEBHOOK_DEALS=
# Webhook du canal #blackway-delivery (tickets de livraison)
SLACK_WEBHOOK_DELIVERY=

# --- Asana ---------------------------------------------------------
ASANA_TOKEN=
ASANA_WORKSPACE_GID=
# GID du modèle de projet Asana (optionnel — si vide, création simple + tâches standard)
ASANA_PROJECT_TEMPLATE_GID=

# --- Serveur ---------------------------------------------------------
PORT=3000

# --- Pipelines HubSpot (générés par scripts/setup-hubspot.js) --------
# Voir .env.generated après l'exécution du script d'installation.
BW_DEAL_PIPELINE_ID=
BW_TICKET_PIPELINE_ID=
